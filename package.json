{
  "name": "wafb",
  "version": "0.3.0",
  "private": true,
  "description": "wafb - The WebADB Forensics Bridge. An androidqf-compatible triage tool.",
  "repository": {
    "type": "git",
    "url": "https://git.lattuga.net/garrett/wafb.git"
  },
  "author": "garrett <garrett@autistici.org>",
  "contributors": [
    "garrett <garrett@autistici.org>",
    "ntonjeta <ntonjeta@autistici.org>"
  ],
  "license": "GPL-3.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @wafb/web dev",
    "dev:core": "pnpm --filter @wafb/core dev",
    "build": "turbo run build",
    "build:dev": "pnpm --filter @wafb/web build:dev",
    "build:web": "turbo run build --filter=@wafb/web",
    "build:core": "turbo run build --filter=@wafb/core",
    "preview": "pnpm --filter @wafb/web preview",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky install",
    "start": "pnpm build:core && pnpm dev:web",
    "version:compute": "node scripts/get-version.mjs",
    "version:sync": "pnpm -r version --no-git-tag-version --allow-same-version \"$(pnpm version:compute)\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "glob": "^13.0.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@yume-chan/android-bin": "^2.1.0",
    "hash-wasm": "^4.12.0"
  }
}