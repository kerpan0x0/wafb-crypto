{
  "name": "@wabf/core",
  "version": "0.1.0",
  "description": "Core library for WABF - The WebADB Forensics Bridge",
  "keywords": [
    "adb",
    "android",
    "forensics",
    "webadb",
    "webusb",
    "mobile-forensics",
    "androidqf",
    "triage"
  ],
  "author": "garrett",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://git.lattuga.net/garrett/WABF.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist coverage node_modules/.cache"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.5.1",
    "@yume-chan/android-bin": "^2.3.2",
    "@yume-chan/scrcpy": "^2.5.1",
    "@yume-chan/stream-extra": "^2.1.0",
    "@yume-chan/struct": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/w3c-web-usb": "^1.0.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "happy-dom": "^12.10.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "vitest": "^1.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}