{
  "name": "@wafb/core",
  "version": "0.1.0",
  "description": "Core library for wafb - The WebADB Forensics Bridge",
  "keywords": [
    "adb",
    "android",
    "forensics",
    "webadb",
    "webusb",
    "mobile-forensics",
    "androidqf",
    "triage"
  ],
  "author": "garrett",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://git.lattuga.net/garrett/wafb.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist coverage node_modules/.cache"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.5.1",
    "@yume-chan/adb-daemon-webusb": "^2.1.0",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/stream-extra": "^2.1.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.10.0",
    "@types/w3c-web-usb": "^1.0.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "happy-dom": "^12.10.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "vitest": "^1.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}